# ==============================================================================
# QuantDB — Environment Configuration Template (.env.example)
# Copy this file to '.env' and provide your local credentials.
# NOTE: Never commit sensitive credentials or password values to Git repository.
# ==============================================================================

# Database Connection Settings (MySQL 8.x / Aiven Cloud)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=QuantDB
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Application Operating Mode:
# 'mock' -> High-fidelity simulated financial time series and paper executions
# 'real' -> Direct integration with local/remote MySQL QuantDB and Quant Analytics Engine
DATA_MODE=mock

# ==============================================================================
# SMTP Email & OTP Verification Configuration
# Required for REAL email verification delivery during Sign Up registration.
# For Gmail, generate an App Password (Google Account -> Security -> 2-Step Verification -> App passwords).
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Firebase Authentication & Firestore Configuration
# Web app public config (safe to expose to client)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=quantdb-728ef
FIREBASE_AUTH_DOMAIN=quantdb-728ef.firebaseapp.com
FIREBASE_STORAGE_BUCKET=quantdb-728ef.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=902285866945
FIREBASE_APP_ID=1:902285866945:web:197ad914d3bf1d8070a140
FIREBASE_MEASUREMENT_ID=G-7WCQ2VMPQ8

# Server-side Firebase Admin credentials (keep private; never commit)
# Option A: Supply FIREBASE_SERVICE_ACCOUNT_JSON as a one-line JSON string
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: Supply FIREBASE_SERVICE_ACCOUNT_PATH to local key file (e.g. serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Firebase setup:
# 1. Enable Authentication > Sign-in method > Email/Password in Firebase Console.
# 2. Copy apiKey and project settings into .env.
# 3. In Firebase Console > Project settings > Service accounts, generate a private key.
#    Save it locally as serviceAccountKey.json or paste into FIREBASE_SERVICE_ACCOUNT_JSON.
# 4. In Cloud Firestore, create collection user_roles; each document ID is the Firebase
#    Authentication UID. Example document: {"role": "QUANT_TRADER", "name": "Trader"}.
#    Missing documents automatically receive USER access. Never allow public clients to write roles.
